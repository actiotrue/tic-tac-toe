FROM oven/bun:1 AS build-stage

WORKDIR /app

COPY package.json bun.lock* ./

RUN bun install --frozen-lockfile

ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_EVENTS_URL
ARG VITE_CLOUDINARY_NAME
ARG VITE_CLOUDINARY_API_SECRET
ARG VITE_CLOUDINARY_API_KEY

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_EVENTS_URL=$VITE_EVENTS_URL
ENV VITE_CLOUDINARY_NAME=$VITE_CLOUDINARY_NAME
ENV VITE_CLOUDINARY_API_SECRET=$VITE_CLOUDINARY_API_SECRET
ENV VITE_CLOUDINARY_API_KEY=$VITE_CLOUDINARY_API_KEY

COPY . .

RUN bun run build-only

CMD cp -rt /output /app/dist/*
